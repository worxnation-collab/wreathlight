{
  "ci": {
    "collect": {
      "url": ["http://127.0.0.1:8787/j/HOPE25", "http://127.0.0.1:8787/c/HOPE25/wreath"],
      "startServerCommand": "npx wrangler dev --local --port 8787 --ip 127.0.0.1",
      "startServerReadyPattern": "Ready on",
      "startServerReadyTimeout": 120000,
      "numberOfRuns": 3,
      "settings": { "onlyCategories": ["performance", "accessibility", "best-practices"], "chromeFlags": "--no-sandbox --headless=new" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
        "categories:accessibility": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
        "categories:best-practices": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci/reports" }
  }
}
